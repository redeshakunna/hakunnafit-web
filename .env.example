NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wompi (Colombia, COP) — https://comercios.wompi.co
# pub_test_/prv_test_ en sandbox, pub_prod_/prv_prod_ en producción
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Asistente de atención (chat con IA) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Panel de super-admin (/panel-hakunna) — solo uso interno
# service_role: Supabase → Project Settings → API (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=
# Contraseña de acceso al panel y secreto de sesión (genera uno propio y largo)
ADMIN_PANEL_PASSWORD=
ADMIN_SESSION_SECRET=

# Notificaciones por correo (opcional) — https://resend.com
# Si se deja vacío, las notificaciones solo aparecen en la campanita del panel.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=
# Dominio público del sitio (para armar el botón "Ver en el panel" del correo)
NEXT_PUBLIC_SITE_URL=https://hakunnafit.com

# Protege /api/cron/cobros-por-vencer (Vercel Cron lo manda automático si existe)
CRON_SECRET=
